{
  "name": "komatool",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "prepare:waifu2x": "node scripts/prepare-waifu2x.mjs",
    "tauri:dev": "bun run prepare:waifu2x && tauri dev",
    "tauri:build:windows": "tauri build --config src-tauri/tauri.windows.conf.json",
    "tauri:build:linux": "tauri build --bundles deb,appimage",
    "tauri:build:macos": "tauri build --target universal-apple-darwin --bundles dmg",
    "build": "vite build",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-dialog": "^2.0.0",
    "lucide-svelte": "^0.468.0",
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@tauri-apps/cli": "^2.0.0",
    "typescript": "~5.7.2",
    "vite": "^6.0.0"
  }
}
